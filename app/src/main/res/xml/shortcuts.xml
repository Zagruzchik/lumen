<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="continue"
        android:enabled="true"
        android:icon="@drawable/ic_sc_play"
        android:shortcutShortLabel="@string/sc_continue"
        android:shortcutLongLabel="@string/sc_continue">
        <intent
            android:action="app.lumen.player.action.CONTINUE"
            android:targetPackage="app.lumen.player"
            android:targetClass="app.lumen.player.ui.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="loved"
        android:enabled="true"
        android:icon="@drawable/ic_sc_loved"
