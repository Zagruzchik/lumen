            android:action="app.lumen.player.action.LOVED"
            android:targetPackage="app.lumen.player"
            android:targetClass="app.lumen.player.ui.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="shuffle"
        android:enabled="true"
        android:icon="@drawable/ic_sc_shuffle"
        android:shortcutShortLabel="@string/sc_shuffle"
        android:shortcutLongLabel="@string/sc_shuffle">
        <intent
            android:action="app.lumen.player.action.SHUFFLE_ALL"
            android:targetPackage="app.lumen.player"
